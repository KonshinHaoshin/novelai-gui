{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NovelAI GUI",
  "version": "0.2.5",
  "identifier": "net.novelgui.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NovelAI GUI - AI 图像生成",
        "width": 1180,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": { "signingIdentity": "-" },
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"]
  }
}
